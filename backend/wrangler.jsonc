{
  // Express on Cloudflare Workers + D1 for CodeAlpha Task 2 (EventHub).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codealpha-eventhub",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],

  // Serve ../frontend as static assets; /api/* routes fall through to the Express Worker.
  "assets": { "directory": "../frontend" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codealpha-eventhub-db",
      // Real D1 database ID (an identifier, not a secret). Local dev (--local) uses .wrangler/.
      "database_id": "0aa960ef-ca6a-49d2-ac0b-b51b1a6615c9",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "CORS_ORIGIN": "https://ca-eventhub.vercel.app",
    "SESSION_TTL_HOURS": "168"
  },

  "observability": { "enabled": true }
}
