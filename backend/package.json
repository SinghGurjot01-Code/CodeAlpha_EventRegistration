{
  "name": "codealpha-eventhub-backend",
  "version": "1.0.0",
  "description": "Express on Cloudflare Workers + D1 backend for CodeAlpha Task 2 EventHub",
  "main": "src/worker.mjs",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --local",
    "start": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply codealpha-eventhub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply codealpha-eventhub-db --remote",
    "deploy": "wrangler deploy",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:unit": "node --test tests/unit.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=20"
  }
}
